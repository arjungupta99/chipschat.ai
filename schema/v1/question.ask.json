{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1,
      "description": "Protocol major version."
    },
    "type": {
      "type": "string",
      "const": "question.ask"
    },
    "id": {
      "type": "string",
      "pattern": "^evt_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "The event's own id. Stable across a retry of the same event."
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When it happened, by Chips' clock. Stamped on the way in; a value the sender writes is replaced."
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "A workspace identifier: `ws_` followed by a ULID."
    },
    "space_id": {
      "description": "The space, when the event belongs to one.",
      "type": "string",
      "pattern": "^spc_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "run_id": {
      "description": "The run, when the event belongs to one.",
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "seq": {
      "description": "Assigned by the server on append, monotonic per workspace. Absent on the way in.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "idempotency_key": {
      "description": "Required on every client-originated write. Sending the same key twice is a no-op.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "person",
            "harness",
            "agent",
            "system"
          ],
          "description": "Whether a person, a harness, one of a harness's agents or Chips itself acted."
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The participant id, or `system` for Chips."
        },
        "harness_id": {
          "description": "For an agent: the harness it speaks through, whose budget and runs are the agent's (ADR 0087). Filled in by Chips.",
          "type": "string",
          "pattern": "^hrn_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "description": "The participant an event is attributed to."
    },
    "ask_id": {
      "type": "string",
      "pattern": "^qst_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Minted by the harness, so a retry is the same ask."
    },
    "questions": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Stable, so answers land on the right question."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "What is being asked."
          },
          "options": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "What comes back in `question.answered`."
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "What the person taps."
                },
                "description": {
                  "description": "What choosing it means.",
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "value",
                "label"
              ],
              "description": "One tappable option."
            },
            "description": "Two to four options."
          },
          "multi_select": {
            "default": false,
            "description": "Whether more than one option may be chosen.",
            "type": "boolean"
          },
          "allow_free_text": {
            "default": false,
            "description": "Whether the person may type instead.",
            "type": "boolean"
          },
          "default_value": {
            "description": "What the harness will take if nobody answers. Its presence lowers the notification tier.",
            "type": "string",
            "maxLength": 120
          }
        },
        "required": [
          "question_id",
          "prompt",
          "options"
        ],
        "description": "One question, with its options."
      },
      "description": "One to four questions."
    },
    "timeout_seconds": {
      "description": "How long to wait for an answer.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 604800
    },
    "on_no_answer": {
      "default": "use_default",
      "description": "What the harness will do if the timeout passes.",
      "type": "string",
      "enum": [
        "use_default",
        "cancel",
        "continue"
      ]
    }
  },
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "workspace_id",
    "actor",
    "ask_id",
    "questions"
  ],
  "description": "One to four questions with tappable options, a default, and a timeout.",
  "$id": "https://chipschat.ai/schema/v1/question.ask.json",
  "title": "QuestionAsk"
}
