    {
      "id": "opencode",
      "name": "OpenCode",
      "line": "An open-source coding agent",
      "needs": "OpenCode installed",
      "program": "opencode",
      "whose": "OpenCode is made by Anomaly and has its own terms. What you send it goes to the model provider you choose.",
