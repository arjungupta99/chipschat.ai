      "terms": "https://openai.com/policies/terms-of-use/",
      "kind": "one-line",
      "command": "chips connect codex '{link}'",
      "package": "@chipschat/acp@1",
      "args": ["~/Chips/.bridges/acp/codex.json"],
      "capabilities": [
        "new_spaces",
        "new_agents",
        "restarts",
        "agents",
        "forks",
        "context_files",
        "models",
        "context_windows"
      ],
      "published": true
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "line": "Open-source, from Nous Research",
      "needs": "Hermes running with its API server on",
      "program": "hermes",
      "whose": "Hermes is made by Nous Research and has its own terms. What you send it goes to the model provider you set up.",
      "terms": "https://github.com/NousResearch/hermes-agent/blob/main/LICENSE",
      "kind": "one-line",
      "command": "chips connect hermes '{link}'",
      "package": "@chipschat/hermes@1",
