{
  "connectors": [
    {
      "id": "openclaw",
      "name": "OpenClaw",
      "line": "An agent that stays running",
      "needs": "OpenClaw set up, with its gateway running",
      "program": "openclaw",
      "whose": "OpenClaw is an open-source project with its own licence. What you send it goes to the model provider you set up.",
      "terms": "https://github.com/openclaw/openclaw/blob/main/LICENSE",
      "kind": "one-line",
      "command": "chips connect openclaw '{link}'",
      "package": "@chipschat/openclaw@1",
      "capabilities": [
        "new_spaces",
        "new_agents",
        "restarts",
        "agents",
        "context_files",
        "models",
        "heartbeats",
        "context_windows",
        "jobs",
        "forks"
      ],
      "published": true
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "line": "Anthropic's coding agent",
      "needs": "Claude Code installed and signed in, and its ACP adapter from npm (npm install -g @agentclientprotocol/claude-agent-acp)",
      "program": "claude",
      "whose": "Claude Code is made by Anthropic and has its own terms. What you send it goes to Anthropic.",
      "terms": "https://code.claude.com/docs/en/legal-and-compliance",
      "start": {
        "answer": "I pay for Claude",
        "suggest": "We'd suggest Claude Code, Anthropic's coding agent.",
        "steps": [
          {
            "says": "Install Claude Code.",
            "line": "curl -fsSL https://claude.ai/install.sh | bash",
            "done": {
              "program": "claude"
            }
          },
          {
            "says": "Sign in. Your browser opens with Anthropic's sign-in.",
            "line": "claude auth login",
            "done": {
              "signedIn": true
            }
          },
          {
            "says": "Install the adapter Chips reaches Claude Code through. It needs npm, which comes with Node.js from nodejs.org.",
            "line": "npm install -g @agentclientprotocol/claude-agent-acp",
            "done": {
              "program": "claude-agent-acp"
            }
          }
        ]
      },
      "kind": "one-line",
      "command": "chips connect claude-code '{link}'",
      "package": "@chipschat/acp@1",
      "args": ["~/Chips/.bridges/acp/claude-code.json"],
      "capabilities": [
        "new_spaces",
        "new_agents",
        "restarts",
        "agents",
        "forks",
        "context_files",
        "models",
        "context_windows"
      ],
      "published": true
    },
    {
